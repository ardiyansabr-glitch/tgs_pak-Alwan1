#include <iostream>
using namespace std;

int main() {
    int makanan, minuman, jumlah;
    int hargaMakanan, hargaMinuman, total;

    cout << "=== MENU MAKANAN ===" << endl;
    cout << "1. Soto  - Rp15000" << endl;
    cout << "2. Rawon - Rp20000" << endl;
    cout << "3. Pecel - Rp10000" << endl;

    cout << "Pilih makanan (1-3): ";
    cin >> makanan;

    if (makanan == 1) {
        hargaMakanan = 15000;
    } else if (makanan == 2) {
        hargaMakanan = 20000;
    } else if (makanan == 3) {
        hargaMakanan = 10000;
    } else {
        cout << "Pilihan makanan tidak valid!" << endl;
        return 0;
    }

    cout << "=== MENU MINUMAN ===" << endl;
    cout << "1. Teh  - Rp3000" << endl;
    cout << "2. Kopi - Rp5000" << endl;

    cout << "Pilih minuman (1-2): ";
    cin >> minuman;

    if (minuman == 1) {
        hargaMinuman = 3000;
    } else if (minuman == 2) {
        hargaMinuman = 5000;
    } else {
        cout << "Pilihan minuman tidak valid!" << endl;
        return 0;
    }

    cout << "Jumlah pesanan: ";
    cin >> jumlah;

    if (jumlah <= 0) {
        cout << "Jumlah pesanan tidak valid!" << endl;
        return 0;
    }

    total = (hargaMakanan + hargaMinuman) * jumlah;

    cout << "=== STRUK PEMBAYARAN ===" << endl;
    cout << "Harga makanan : Rp" << hargaMakanan << endl;
    cout << "Harga minuman : Rp" << hargaMinuman << endl;
    cout << "Jumlah pesanan: " << jumlah << endl;
    cout << "Total bayar   : Rp" << total << endl;



    return 0;
}
