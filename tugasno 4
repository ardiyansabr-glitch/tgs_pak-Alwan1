#include <iostream>
using namespace std;

int main() 
{
    int nilai;
    char grade;

    cout << "Masukkan nilai (0-100): ";
    cin >> nilai;

    if (nilai < 0 || nilai > 100) {
        cout << "Nilai tidak valid!\n";
        return 0;
    }

    if (nilai >= 90) {
        grade = 'A';
    } else if (nilai >= 80) {
        grade = 'B';
    } else if (nilai >= 70) {
        grade = 'C';
    } else {
        grade = 'D';
    }

    cout << "Nilai: " << nilai << endl;
    cout << "Grade: " << grade << endl;


    return 0;
}
